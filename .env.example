# ---------------------------------------------------------------------------
# TestYourself — muhit o'zgaruvchilari namunasi.
# Lokal ish uchun: `cp .env.example .env` va qiymatlarni to'ldiring.
# Prodda (Render) bu qiymatlar dashboard'dagi Environment bo'limiga kiritiladi.
# ---------------------------------------------------------------------------

# MAJBURIY. Har bir muhit uchun alohida generatsiya qiling:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Prodda HAR DOIM False.
DEBUG=False

# Vergul bilan ajratiladi.
ALLOWED_HOSTS=dtm-test.onrender.com,localhost,127.0.0.1

# Frontend domeni. Prod SPA manzilini shu yerga qo'shmasangiz CORS bloklaydi.
#
# ESLATMA: mahalliy (native) iOS/Android ilovalar `Origin` header yubormaydi,
# shuning uchun ular uchun bu ro'yxatga hech narsa qo'shish shart emas —
# telefonlar baribir ulanaveradi. Bu sozlama faqat brauzer va WebView
# (Capacitor/Ionic) mijozlariga tegishli.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Zarurat bo'lsa CORS ni hammaga ochish (ehtiyot bo'ling).
CORS_ALLOW_ALL_ORIGINS=False

# Proxy ortida admin login POST uchun majburiy. Sxema (https://) bilan yoziladi.
CSRF_TRUSTED_ORIGINS=https://dtm-test.onrender.com

# --- Ma'lumotlar bazasi -----------------------------------------------------
# Prodda Render bitta DATABASE_URL beradi — shuni ishlating.
# DATABASE_URL=postgres://user:parol@host:5432/dbname
#
# Lokalda esa alohida o'zgaruvchilar:
DB_NAME=test_univora
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis ------------------------------------------------------------------
# MAJBURIY: kesh, throttling va Celery shunga bog'liq. Yo'q bo'lsa API 500 qaytaradi.
REDIS_URL=redis://127.0.0.1:6379/1

# Odatda REDIS_URL bilan bir xil; kerak bo'lsa alohida beriladi.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Celery worker ishlamayotgan muhitda vazifalarni inline bajarish uchun True.
CELERY_TASK_ALWAYS_EAGER=False

# --- Kirish usullari --------------------------------------------------------
# Android va web mijozlar uchun.
GOOGLE_CLIENT_ID=

# iPhone/iPad ("Sign in with Apple") uchun `aud` qiymatlari: iOS bundle id
# va (bo'lsa) web Services ID. Vergul bilan bir nechtasini berish mumkin.
# Bo'sh qolsa Apple orqali kirish o'chirilgan hisoblanadi.
APPLE_CLIENT_IDS=

# --- Telegram (obuna arizasi) ----------------------------------------------
# Foydalanuvchiga ko'rsatiladigan "Admin bilan bog'lanish" havolasi.
ADMIN_TELEGRAM_LINK=https://t.me/akobir_ETA

# Bularni to'ldirsangiz har bir yangi ariza adminga BOTdan avtomatik keladi.
# Bo'sh qolsa ariza faqat bazaga yoziladi va admin panelda ko'rinadi.
# Chat id ni olish: botga yozib, https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Loglar -----------------------------------------------------------------
LOG_LEVEL=INFO

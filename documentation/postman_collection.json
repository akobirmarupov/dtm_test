{
  "info": {
    "name": "DTM Test - TO'LIQ API COLLECTION",
    "description": "TestYourself Platform - Barcha API endpoints",
    "version": "2.0.0"
  },
  "_postman_variable_scope": "environment",
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": "YOUR_ACCESS_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 AUTHENTICATION (Avtentifikatsiya)",
      "item": [
        {
          "name": "Google orqali Kirish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"GOOGLE_ID_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/google/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "google", ""]
            },
            "description": "Google OAuth Token bilan login qilish"
          }
        },
        {
          "name": "O'z Profili Ko'rish (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/me/",
              "path": ["api", "auth", "me", ""]
            },
            "description": "Joriy foydalanuvchining ma'lumotlarini ko'rish"
          }
        },
        {
          "name": "Tizimdan Chiqish (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"REFRESH_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/logout/",
              "path": ["api", "auth", "logout", ""]
            },
            "description": "Logout qilish"
          }
        }
      ]
    },
    {
